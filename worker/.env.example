# Copia a .env solo para desarrollo LOCAL. En AKS, Key Vault inyecta estos valores
# vía Secret Store CSI Driver + Workload Identity (igual que en tools-api).

STORAGE_ACCOUNT_NAME=stdocuassistdev001
STORAGE_CONTAINER=documentos

DOCINTEL_ENDPOINT=https://docuassist-docintel-dev.cognitiveservices.azure.com/
DOCINTEL_KEY=

FOUNDRY_ENDPOINT=https://docuassist-foundry-dev.openai.azure.com/
FOUNDRY_KEY=
EMBEDDINGS_DEPLOYMENT=embeddings-model

SEARCH_ENDPOINT=https://docuassist-search-dev.search.windows.net
SEARCH_KEY=
SEARCH_INDEX_NAME=documentos-index

MAX_FILE_SIZE_MB=25
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
