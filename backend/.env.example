# Copia a .env solo para desarrollo LOCAL. En AKS, Key Vault inyecta estos valores.

ENTRA_TENANT_ID=
ENTRA_AUDIENCE=api://<tu-app-id>
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

FOUNDRY_ENDPOINT=https://docuassist-foundry-dev.openai.azure.com/
FOUNDRY_KEY=
GEN_MODEL_DEPLOYMENT=gen-model
ROUTER_MODEL_DEPLOYMENT=router-model
EMBEDDINGS_DEPLOYMENT=embeddings-model

SEARCH_ENDPOINT=https://docuassist-search-dev.search.windows.net
SEARCH_KEY=
SEARCH_INDEX_NAME=documentos-index
RAG_TOP_K=5

COSMOS_ENDPOINT=https://docuassist-cosmos-dev.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE=AgentState
COSMOS_CONTAINER=Conversaciones

TOOLS_API_URL=http://tools-api-svc.tools-api.svc.cluster.local
MIN_SEARCH_SCORE=0.55
