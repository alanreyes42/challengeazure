# Copia este archivo a .env para desarrollo LOCAL únicamente.
# En AKS, estas variables las inyecta el Secret Store CSI Driver desde Key Vault
# (vía Workload Identity), nunca se hardcodean ni se suben al repo.

ENTRA_TENANT_ID=
ENTRA_AUDIENCE=api://<tu-app-id>

SQL_SERVER=docuassist-sql-dev-03.database.windows.net
SQL_DATABASE=db-negocio
SQL_USER=sqladminuser
SQL_PASSWORD=

COSMOS_ENDPOINT=https://docuassist-cosmos-dev.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE=AgentState
COSMOS_CONTAINER=Conversaciones

QUERY_TIMEOUT_SECONDS=5
MAX_ROWS_RETURNED=50
RATE_LIMIT_PER_MINUTE=30
